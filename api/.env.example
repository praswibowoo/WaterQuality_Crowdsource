DATABASE_URL="postgresql://user:password@localhost:5432/waterquality?schema=public"
PORT=3001
# For development: allow Vite dev server
CORS_ORIGIN=http://localhost:5173
# Admin password for seed (default: admin123, change after first login)
ADMIN_PASSWORD=change-me-to-a-strong-password
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-secret-at-least-32-chars
NODE_ENV=development
# General API rate limit per 15 minutes per IP (default: 300)
RATE_LIMIT_MAX=300
# CSP: set to "true" to enforce (blocks violations); omit/false for report-only
CSP_ENFORCE_MODE=false
# CSP: comma-separated list of permitted map tile domains
# Defaults to OpenStreetMap if not set
CSP_TILE_DOMAINS=https://tile.openstreetmap.org,https://*.tile.openstreetmap.org